# Copiar este archivo a .env antes de correr el proyecto
# y completar con las credenciales de tu base de datos (Neon o Postgres local).

# Conexión que usa la app (en Neon, la versión con "-pooler" en el host).
DATABASE_URL="postgresql://usuario:clave@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Conexión directa, solo para migraciones (sin "-pooler" en el host).
DIRECT_URL="postgresql://usuario:clave@host.region.aws.neon.tech/neondb?sslmode=require"
